#!/usr/bin/env python3

import argparse
import logging
import shutil
import sys
from datetime import datetime, time
from pathlib import Path


log = logging.getLogger("my-copy-by-date")


def parse_datetime(value: str, *, is_end: bool) -> float:
    try:
        if len(value) == 10:
            date = datetime.strptime(value, "%Y-%m-%d").date()
            dt = datetime.combine(date, time.max if is_end else time.min)
        else:
            dt = datetime.fromisoformat(value)
    except ValueError as exc:
        raise argparse.ArgumentTypeError(
            f"invalid date/time {value!r}; expected YYYY-MM-DD or an ISO datetime"
        ) from exc

    return dt.timestamp()


def parse_range(value: str) -> tuple[float, float]:
    if ".." not in value:
        raise argparse.ArgumentTypeError("range must have the form START..END")

    start_text, end_text = value.split("..", 1)
    if not start_text or not end_text:
        raise argparse.ArgumentTypeError("both START and END are required")

    start = parse_datetime(start_text, is_end=False)
    end = parse_datetime(end_text, is_end=True)

    if start > end:
        raise argparse.ArgumentTypeError("START must not be later than END")

    return start, end


def find_candidates(source: Path, start: float, end: float) -> tuple[list[Path], int]:
    log.info("Finding candidate files in %s", source)

    candidates: list[Path] = []
    examined = 0

    for path in source.rglob("*"):
        if not path.is_file():
            continue

        examined += 1

        try:
            modified = path.stat().st_mtime
        except OSError as exc:
            log.warning("Could not inspect %s: %s", path, exc)
            continue

        if start <= modified <= end:
            candidates.append(path)
            log.debug(
                "Candidate: %s (modified %s)",
                path,
                datetime.fromtimestamp(modified).isoformat(sep=" ", timespec="seconds"),
            )

    log.info("Examined %d file(s)", examined)
    log.info("Found %d candidate file(s)", len(candidates))
    return candidates, examined


def copy_candidates(
    candidates: list[Path],
    source: Path,
    destination: Path,
) -> tuple[int, int]:
    log.info("Creating destination directory if needed: %s", destination)
    destination.mkdir(parents=True, exist_ok=True)

    log.info("Copying %d candidate file(s)", len(candidates))

    copied = 0
    failed = 0

    for index, src in enumerate(candidates, start=1):
        relative = src.relative_to(source)
        dst = destination / relative

        try:
            dst.parent.mkdir(parents=True, exist_ok=True)
            log.debug(
                "[%d/%d] Copying %s -> %s",
                index,
                len(candidates),
                src,
                dst,
            )
            shutil.copy2(src, dst)
            copied += 1
        except OSError as exc:
            failed += 1
            log.error(
                "[%d/%d] Failed to copy %s: %s",
                index,
                len(candidates),
                src,
                exc,
            )

    return copied, failed


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Copy files whose modification time falls within a date range."
    )
    parser.add_argument(
        "--from",
        dest="source",
        type=Path,
        required=True,
        help="source directory",
    )
    parser.add_argument(
        "--to",
        dest="destination",
        type=Path,
        required=True,
        help="destination directory",
    )
    parser.add_argument(
        "--range",
        dest="date_range",
        type=parse_range,
        required=True,
        metavar="START..END",
        help="inclusive modification-time range",
    )
    parser.add_argument(
        "-v",
        "--verbose",
        action="store_true",
        help="show individual candidate and copy operations",
    )

    args = parser.parse_args()

    logging.basicConfig(
        level=logging.DEBUG if args.verbose else logging.INFO,
        format="%(message)s",
    )

    source = args.source.expanduser().resolve()
    destination = args.destination.expanduser().resolve()
    start, end = args.date_range

    if not source.is_dir():
        parser.error(f"source directory does not exist: {source}")

    log.info("Source:      %s", source)
    log.info("Destination: %s", destination)
    log.info(
        "Date range:  %s .. %s",
        datetime.fromtimestamp(start).isoformat(sep=" ", timespec="seconds"),
        datetime.fromtimestamp(end).isoformat(sep=" ", timespec="seconds"),
    )

    candidates, _ = find_candidates(source, start, end)

    if not candidates:
        log.info("Nothing to copy.")
        return 0

    copied, failed = copy_candidates(candidates, source, destination)

    log.info("")
    log.info("Done.")
    log.info("Candidates: %d", len(candidates))
    log.info("Copied:     %d", copied)
    log.info("Failed:     %d", failed)

    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
